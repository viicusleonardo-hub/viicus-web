# Copie para `.env.local` (ignorado pelo git) e preencha o que for usar.
# Em produção estes valores vivem nas variáveis de ambiente do projeto na
# Vercel, não em arquivo.

# --------------------------------------------------------------- Sentry
#
# VAZIO DESLIGA. Sem DSN o SDK não é inicializado em nenhum dos três pontos
# (navegador, Node e Edge) — em desenvolvimento é o modo desejado, porque erro
# no terminal e no console é mais útil que erro no painel.
#
# `NEXT_PUBLIC_` porque ele precisa chegar ao navegador. E isso é seguro: o
# DSN só autoriza escrever evento no projeto, não ler nada — ele viaja dentro
# de todo site e aplicativo que o usa.
NEXT_PUBLIC_SENTRY_DSN=

# Organização e projeto — usados só no BUILD, para enviar os source maps.
SENTRY_ORG=
SENTRY_PROJECT=

# Token de envio de source map. ESTE é segredo e nunca vai para o git: na
# Vercel, variável de ambiente do projeto.
#
# Sem ele o build NÃO falha — ele apenas não sobe o mapa, e o painel passa a
# mostrar stack trace minificado. Se os erros da web chegarem ilegíveis, é o
# primeiro lugar a olhar.
SENTRY_AUTH_TOKEN=
